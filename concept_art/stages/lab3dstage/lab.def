[Info]
name = "Seth lab"
displayname = "Seth lab"
author = "Violin Ken"

;--------------------------------------------------------
[Camera]
startx = 0
starty = 0
boundleft = -1600
boundright = 1600
boundhigh = -1000
boundlow = 0

verticalfollow = .6
floortension = 200
tension = 200

overdrawhigh = 120
overdrawlow = 120
cuthigh = 0
cutlow = 0
autocenter = 1

;Zoom is not yet supported in 3D stages.
	startzoom=1.2
	zoomout=0.8 ;;c_zo
	zoomin=1.0 ;;c_zi
zoomindelay = 40


;Field of view. 30 is good for photorealistic scenes, but feel free to tweak this to your preference.
fov = 40

yshift = -.35
;--------------------------------------------------------
[PlayerInfo]
;--- Player 1 ---
p1startx = -280
p1starty = 0
p1facing = 1

;--- Player 2 ---
p2startx = 280
p2starty = 0
p2facing = -1

;--- Player 3 ---
p3startx = -400
p3starty = 0
p3facing = 1

;--- Player 4 ---
p4startx = 400
p4starty = 0
p4facing = -1

;--- Common ---
leftbound  = -4000
rightbound =  4000

;--------------------------------------------------------
[Bound]
screenleft = 35
screenright =35

;--------------------------------------------------------
[StageInfo]
zoffset = 660

autoturn = 1
resetBG = 0

localcoord = 1280,960
xscale = 1
yscale = 1

portraitscale = 1

;--------------------------------------------------------
[Shadow]
intensity=100
yscale=0.25
fade.range=-100,0

;--------------------------------------------------------
[Reflection]
intensity = 0
yscale=1
fade.range=-100,0
;--------------------------------------------------------
[Music]
bgmusic =sound\seth2.mp3
bgmvolume = 100

;========================================================
[BGdef]

;Filename of 3D model file
;Supported file types are gltf and glb; supported by most modern 3D model programs.
;It is recommended to use PNG/JPEG/embedded image format for textures. Compressed DDS textures are not supported.
;Make sure the world origin of the model is at the camera's starting point.
model = lab.glb

;Filename of .sff file, required by spec (and for stage portraits)
spr = LAB.sff

;debugbg = 0

;-------------------------------------
; Model element definition
[Model]
environment = lab.hdr
environmentintensity = .5

; X, Y, and Z coordinates of the model
offset = 0,-.08,-.5

; Scale of the model
scale = 0.09, 0.09, 0.09
;-------------------------------------
; Stage portrait data
[Begin Action 9000]
9000,1, 0,0,-1
