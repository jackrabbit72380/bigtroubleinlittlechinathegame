#Credit to toukachan5900 for the original glow module!
#------------------[implementation]-------------
#--------------------------------------------------------
# The glow itself. The numbers come from the character maps the in-game
# Aura screen (external/mods/auraopts.lua) fills in every frame; with no
# maps set - a build where that module failed, say - the ifElse defaults
# keep the module looking exactly as released.
#
# btlc_aura_off     1 = nothing drawn at all
# btlc_aura_type    1 = GLOW, 2 = AURA; unset reads as AURA
# btlc_aura_style   1 = the power ladder, 2 = one colour (AURA only)
# btlc_aura_single  1 = one colour; still written for builds with the old module
# btlc_aura_r/g/b   that colour
# btlc_aura_alpha / quality / size   the glow's own arguments
# btlc_aura_life    0 = always, otherwise show below this % of life
# btlc_aura_under   1 = draw over the fighter, unset = behind it
# btlc_aura_minpower  hide the glow below this power, unset = any power
# btlc_aura_follow   helpers only: 1 = glow around this helper's own
#                    animation, which is how text sprites get a glow
#
# GLOW and AURA are the same glow function given different numbers, not two
# copies of it: GLOW is one steady colour at full brightness with a tight
# radius, whatever the power, and AURA is the power ladder below.
[StateDef +1]
ignoreHitPause
{
	# A helper is not a fighter: it has no life and no power, so the ladder
	# below means nothing to it. It glows its own animation only when its state
	# asks for it with map(btlc_aura_follow) := 1.
	if isHelper && map(btlc_aura_follow) = 1 && map(btlc_aura_off) = 0
	{
		let halpha = ifElse(map(btlc_aura_alpha) > 0, map(btlc_aura_alpha), 100);
		let hquality = ifElse(map(btlc_aura_quality) > 0, map(btlc_aura_quality), 50);
		let hsize = ifElse(map(btlc_aura_size) > 0, map(btlc_aura_size), 10);
		call glow($halpha, $hquality, $hsize, map(btlc_aura_r), map(btlc_aura_g), map(btlc_aura_b), 1, 92000, 1, 1);
	}
	if !isHelper && life > 0 && map(btlc_aura_off) = 0 && !isAsserted(Invisible)
	{
		let alpha = ifElse(map(btlc_aura_alpha) > 0, map(btlc_aura_alpha), 100);
		let quality = ifElse(map(btlc_aura_quality) > 0, map(btlc_aura_quality), 50);
		let size = ifElse(map(btlc_aura_size) > 0, map(btlc_aura_size), 10);
		let kind = ifElse(map(btlc_aura_type) > 0, map(btlc_aura_type), 2);
		let watch = map(btlc_aura_life);
		let floor = map(btlc_aura_minpower);
		if power >= $floor && ($watch = 0 || life < lifeMax * $watch / 100)
		{
			if $kind = 1
			{
				# GLOW: the released Glow.zss numbers - one colour, no ladder
				# alpha, quality, size, r, g, b, priority, id, updatehitpause, movehitpause
				call glow($alpha, $quality, $size, map(btlc_aura_r), map(btlc_aura_g), map(btlc_aura_b), 1, 92000, 1, 1);
			}
			else
			{
				if map(btlc_aura_style) = 2
				{
					# AURA, one colour
					call glow($alpha, $quality, $size, map(btlc_aura_r), map(btlc_aura_g), map(btlc_aura_b), 1, 92000, 1, 1);
				}
				else
				{
					# AURA, the power ladder
					if power >= 1000 && power < 2000
					{
						call glow($alpha, $quality, $size, 255,0,0, 1, 92000, 1, 1);
					}
					if power >= 2000 && power < 3000
					{
						call glow(ifElse($alpha > 220, 220, $alpha + 15), $quality, $size, 0,255,0, 1, 92000, 1, 1);
					}
					if power >= 3000
					{
						call glow(ifElse($alpha > 185, 185, $alpha + 35), 30, 5.5, 175 + 175*cos(gameTime * 0.1),180 + 180* sin (gameTime * 0.08),180 + 180 * cos (gameTime * 0.05 +45), 1, 92000, 1, 1);
					}
				}
			}
		}
	}
}

#===============================<Glow Function>==============================
#-> Glow Function
[Function glow(alpha, quality, size, r,g,b, p, id, ignorehit, movehitpause)] 
#alpha, quality, size, r, g, b, sprpriority, updatehitpause, movehitpause

#alpha: 		controls the opacity of explods
#quality: 		controls distribution of the explod scattering(divided by 10 and then multiplied by nested loop)
#size: 			glow radius;
#r,g,b: 		colors;
#sprpriority: 	sprpriority of the explods (usually smaller than 0);
#ignorehit: 	updates the anim during hitpause;
#movehitpause: 	lets the explod run during hitpause;(controls ignorehitpause parameter on explods)

ignoreHitPause{
	let a = $alpha / ($quality*0.25);
	let q = float($quality/10);
	if ((hitPauseTime && $ignorehit) || !hitPauseTime || isAsserted(animatehitpause)) && !pauseTime{
	map(glow.frame) := ifElse(hitPauseTime && !isAsserted(animatehitpause), animElemNo(-1), animElemNo(0));}
	removeExplod{id: $id;}
	
	#p2facing fix
	if !isHelper && getHitVar(frame) && map(previous_facing) = facing && getHitVar(facing)
	{
		if (facing != (-playerId(getHitVar(id)), facing) * getHitVar(facing))
		{
			 let f = -1;
		}
	}
	map(previous_facing) := facing;
	#Main Loop
	for i = 0; $q; 1{
		for h = 0; $q; 1
		{
			if (($h%2 = 0 && $i%2 = 0) || ($h%2 = 1 && $i%2 = 1)) && (gameTime%2 = 0)
			{
				explod{
					anim: anim; 
					id: $id; 
					sprpriority: $p; 
					postype: p1;
					pos: -($size/2)+$h*($size/$q),-($size/2)+$i*($size/$q);
					removetime: 2;
					animelem: map(glow.frame);
					scale: 1 * const(size.xscale) * (scale x), 1 * const(size.yscale) * (scale y);
					trans: addalpha;
					alpha: $a,255-$a;
					ownpal: 1;
					under: ifElse(map(btlc_aura_under) = 1, 0, 1);
					facing: ifElse($f = -1, -1, 1);
					angle: angle;
					xshear: xShear;
					palfx.time: -1;
					palfx.add: 256,256,256;
					palfx.mul: $r,$g,$b;
					pausemovetime: -1;
					supermovetime: -1;
					ignorehitpause: $movehitpause;
					animplayerno: animPlayerNo;
				}
			}
						
			if (($h%2 = 0 && $i%2 = 1) || ($h%2 = 1 && $i%2 = 0)) && (gameTime%2 = 1)
			{
				explod{
					anim: anim; 
					id: $id; 
					sprpriority: $p; 
					postype: p1;
					pos: -($size/2)+$h*($size/$q),-($size/2)+$i*($size/$q);
					removetime: 2;
					animelem: map(glow.frame);
					scale: 1 * const(size.xscale) * (scale x), 1 * const(size.yscale) * (scale y);
					trans: addalpha;
					alpha: $a,255-$a;
					ownpal: 1;
					under: ifElse(map(btlc_aura_under) = 1, 0, 1);
					facing: ifElse($f = -1, -1, 1);
					angle: angle;
					xshear: xShear;
					palfx.time: -1;
					palfx.add: 256,256,256;
					palfx.mul: $r,$g,$b;
					pausemovetime: -1;
					supermovetime: -1;
					ignorehitpause: $movehitpause;
					animplayerno: animPlayerNo;
				}
			}
		}
	}
}
