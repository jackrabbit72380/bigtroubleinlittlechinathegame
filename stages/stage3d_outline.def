;This stage and its assets are licensed under MIT.
;--------------------------------------------------------
[Info]
name = "Third Heights"
displayname = "Third Heights Outline"
versiondate = 11,25,2023
mugenversion = 1.1
author = "SuperFromND"; modifed by Eiton

;--------------------------------------------------------
[Camera]
startx = 0
starty = 0
boundleft = -880
boundright = 880
boundhigh = -450
boundlow = 0

verticalfollow = .85
floortension = 200
tension = 200

overdrawhigh = 120
overdrawlow = 120
cuthigh = 0
cutlow = 0

zoomout = 0.72

;A longer lens than the day pass (fov 22 against 30) with a wider pan, so
;the same island reads as somewhere far away and empty.
fov = 22
;--------------------------------------------------------
zoomin = 1
[PlayerInfo]
;--- Player 1 ---
p1startx = -280
p1starty = 0
p1facing = 1

;--- Player 2 ---
p2startx = 280
p2starty = 0
p2facing = -1

;--- Common ---
leftbound  = -4000
rightbound =  4000

;--------------------------------------------------------
[Bound]
screenleft = 60
screenright = 60

;--------------------------------------------------------
[StageInfo]
zoffset = 660

autoturn = 1
resetBG = 1

localcoord = 1280, 720
xscale = 1
yscale = 1

; The stage card draws each stage's 240x100-class portrait at the same
; apparent size, and the engine's automatic portrait scale falls with the
; stage's localcoord - so a 1280x720 stage draws 1.5x larger than this
; roster's 1920x1080 ones. 4 / 1.5 = 3.375, which lands this stage's
; 240x100 portrait at the same 1215-wide card as every other stage
; instead of 18% oversized and cropped.
portraitscale = 3.375

;--------------------------------------------------------
[Shadow]
intensity = 128
color = 44,26,86
yscale = .3
fade.range = 0,0

;--------------------------------------------------------
[Reflection]
intensity = 0

;--------------------------------------------------------
[Music]
bgmusic = sound/Big Trouble in Little China OST Movie Version/6 - The Storms.ogg
bgmvolume = 100

;========================================================
[BGdef]

;Filename of 3D model file
;Supported file types are gltf and glb; supported by most modern 3D model programs.
;It is recommended to use PNG/JPEG/embedded image format for textures. Compressed DDS textures are not supported.
;Make sure the world origin of the model is at the camera's starting point.
model = stage3d_outline.glb

;Filename of .sff file, required by spec (and for stage portraits)
spr = stage3d_outline.sff

;debugbg = 0

;-------------------------------------
; Model element definition
[Model]

; X, Y, and Z coordinates of the model
offset = 0,-0.2,-0.9

; Scale of the model
scale = 0.05, 0.05, 0.05

;-------------------------------------
; Night weather: a violet wash sits over the whole scene, cold motes climb through
; it, and mist crawls along the water. The wash is a solid tile, the motes tile
; both ways and the mist tiles sideways, so panning never finds an edge.
[BG night wash]
type = normal
spriteno = 1,2
layerno = 1
start = 0, 0
tile = 1,1
trans = none

[BG cold motes]
type = normal
spriteno = 1,0
layerno = 1
start = 0, 0
tile = 1,1
velocity = 0, -1.1
trans = add

[BG night mist]
type = normal
spriteno = 1,1
layerno = 1
start = 0, 0
tile = 1,0
velocity = -1.5, 0
trans = none

;-------------------------------------
; Stage portrait data
[Begin Action 9000]
9000,1, 0,0,-1
