;--------------------------------------------------------
[Info]
name = "Third Heights"
displayname = "Third Heights"
versiondate = 11,25,2023
mugenversion = 1.1
author = "SuperFromND"

;--------------------------------------------------------
[Camera]
startx = 0
starty = 0
boundleft = -700
boundright = 700
boundhigh = -450
boundlow = 0

verticalfollow = .85
floortension = 200
tension = 200

overdrawhigh = 120
overdrawlow = 120
cuthigh = 0
cutlow = 0

;zoomout = .8

;Field of view. 30 is good for photorealistic scenes, but feel free to tweak this to your preference.
fov = 30
;--------------------------------------------------------
zoomout = 0.75
zoomin = 1
[PlayerInfo]
;--- Player 1 ---
p1startx = -280
p1starty = 0
p1facing = 1

;--- Player 2 ---
p2startx = 280
p2starty = 0
p2facing = -1

;--- Common ---
leftbound  = -4000
rightbound =  4000

;--------------------------------------------------------
[Bound]
screenleft = 60
screenright = 60

;--------------------------------------------------------
[StageInfo]
zoffset = 660

autoturn = 1
resetBG = 1

localcoord = 1280, 720
xscale = 1
yscale = 1

; The stage card draws each stage's 240x100-class portrait at the same
; apparent size, and the engine's automatic portrait scale falls with the
; stage's localcoord - so a 1280x720 stage draws 1.5x larger than this
; roster's 1920x1080 ones. 4 / 1.5 = 3.375, which lands this stage's
; 240x100 portrait at the same 1215-wide card as every other stage
; instead of 18% oversized and cropped.
portraitscale = 3.375

;--------------------------------------------------------
[Shadow]
intensity = 96
color = 0,0,0
yscale = .3
fade.range = 0,0

;--------------------------------------------------------
[Reflection]
intensity = 0

;--------------------------------------------------------
[Music]
bgmusic = sound/Big Trouble in Little China OST Game Version/04 - Here Come The Storms.ogg
bgmvolume = 100

;========================================================
[BGdef]

;Filename of 3D model file
;Supported file types are gltf and glb; supported by most modern 3D model programs.
;It is recommended to use PNG/JPEG/embedded image format for textures. Compressed DDS textures are not supported.
;Make sure the world origin of the model is at the camera's starting point.
;model = stage3d.glb   ; the island is painted instead - see [BG island]

;Filename of .sff file, required by spec (and for stage portraits)
spr = stage3d.sff

;debugbg = 0

;-------------------------------------
; Model element definition
; No [Model] block here on purpose. This stage draws a painted island (see
; [BGdef]) and its 3D model is switched off; a [Model] section left behind with
; no model to describe makes the engine dereference the missing model while the
; stage loads, and the game dies with a nil pointer panic. Removed 2026-11-08.

; X, Y, and Z coordinates of the model

; Scale of the model

;-------------------------------------
; Day weather: high cloud haze drifting across the top, spray lifting off the
; water. Both bands are seamless sideways, so a layer can tile and scroll for as
; long as the fight lasts without showing a repeat.
;-------------------------------------
; The island itself, painted. The 3D model is off: the engine has a model path and
; the .glb is sound, but on the machine these stages are played on the model was
; never drawn and the screen was a black field with only the weather over it. This
; sprite is the stage's own localcoord, 1280x720, so it draws 1:1, and it tiles
; sideways for as long as the camera travels.
[BG sky]
type = normal
spriteno = 3,0
layerno = 0
start = 0, 0
tile = 1,0
trans = none

[BG lip]
type = normal
spriteno = 3,3
layerno = 1
start = 0, 0
tile = 1,0
trans = none

[BG high haze]
type = normal
spriteno = 1,0
layerno = 1
start = 0, -40
tile = 1,0
velocity = -1.2, 0
trans = none

[BG water spray]
type = normal
spriteno = 1,1
layerno = 1
start = 0, 0
tile = 1,0
velocity = -2.6, 0
trans = none

;-------------------------------------
; Stage portrait data
[Begin Action 9000]
9000,1, 0,0,-1
