;This stage's model and base preview are licensed under MIT (SuperFromND's
;Third Heights pack); the reframing, the card and the weather are painted here.
;Three Storms, three stages: this is rain's terrace. The pack ships one island
;in two renders, so rather than invent a third scene the same model is framed
;lower and wider, and two painted rain sheets fall across it - one behind the
;fighters, one in front - under a slate wash and driving mist. Lightning strikes
;across the sky every few seconds, and external/mods/rainthunder.lua rumbles
;behind each flash from the sample tools/build_thunder.py puts in system.snd.
;Its card is graded cold with rain streaked over it, so the select screen tells
;the three apart at a glance.
;--------------------------------------------------------
[Info]
name = "Third Heights Rainfall"
displayname = "Third Heights Rainfall"
versiondate = 11,25,2023
mugenversion = 1.1
author = "SuperFromND; reframed for this roster"

;-------------------------------------
; A stage DEF cannot play a sound, so the storm's rumble is played by
; external/mods/rainthunder.lua, which reads this constant back with the
; stageConst() trigger and rumbles two ticks after each lightning strike.
[Constants]
RainThunder = 1

;--------------------------------------------------------
[Camera]
startx = 0
starty = 0
boundleft = -520
boundright = 520
boundhigh = -420
boundlow = 0

verticalfollow = .85
floortension = 200
tension = 200

overdrawhigh = 120
overdrawlow = 120
cuthigh = 0
cutlow = 0

;Wider and further back than the other two passes (fov 38 against their 30,
;zoomout 0.72 against 0.75), so the same island reads as a different place.
fov = 38
zoomout = 0.72
zoomin = 1
;--------------------------------------------------------
[PlayerInfo]
;--- Player 1 ---
p1startx = -280
p1starty = 0
p1facing = 1

;--- Player 2 ---
p2startx = 280
p2starty = 0
p2facing = -1

;--- Common ---
leftbound  = -4000
rightbound =  4000

;--------------------------------------------------------
[Bound]
screenleft = 60
screenright = 60

;--------------------------------------------------------
[StageInfo]
zoffset = 660

autoturn = 1
resetBG = 1

localcoord = 1280, 720
xscale = 1
yscale = 1

; The stage card draws each stage's 240x100-class portrait at the same
; apparent size, and the engine's automatic portrait scale falls with the
; stage's localcoord - so a 1280x720 stage draws 1.5x larger than this
; roster's 1920x1080 ones. 4 / 1.5 = 3.375 lands this stage's 240x100
; portrait at the same 1215-wide card as every other stage.
portraitscale = 3.375

;--------------------------------------------------------
[Shadow]
intensity = 132
color = 26,18,52
yscale = .3
fade.range = 0,0

;--------------------------------------------------------
[Reflection]
intensity = 0

;--------------------------------------------------------
[Music]
bgmusic = sound/Big Trouble in Little China OST Movie Version/8 - Here Come the Storms.ogg
bgmvolume = 100

;========================================================
[BGdef]

;The same island as stage3d.def, framed lower and further back.
model = stage3d.glb

;Its own card, so the select screen shows the rainy pass.
spr = stage3d_rain.sff

;-------------------------------------
; Model element definition
[Model]

offset = 0,-0.16,-0.62
scale = 0.045, 0.045, 0.045

;-------------------------------------
; Storm weather: two painted rain sheets fall at different speeds, one behind the
; fighters and one in front, under a slate wash, with mist driving across the
; water. The sheets tile both ways, so the rain never runs out however long the
; fight lasts or however far the camera travels.
[BG rain behind]
type = normal
spriteno = 1,0
layerno = 0
start = 0, 0
tile = 1,1
velocity = 1.4, 16
trans = none

[BG storm wash]
type = normal
spriteno = 1,2
layerno = 1
start = 0, 0
tile = 1,1
trans = none

[BG driving mist]
type = normal
spriteno = 1,3
layerno = 1
start = 0, 0
tile = 1,0
velocity = -3.4, 0
trans = none

[BG rain in front]
type = normal
spriteno = 1,1
layerno = 1
start = 0, 0
tile = 1,1
velocity = 3.2, 30
trans = none

;-------------------------------------
; Lightning: an animated sheet, clear most of the time, that throws a flash across
; the sky every few seconds. Drawn with trans = add, so it lifts the scene instead
; of painting over it, and above the rain so a strike reads through it. The cycle
; itself is action 9001, at the end of this file.
[BG lightning]
type = anim
actionno = 9001
layerno = 1
start = 0, 0
tile = 1,1
trans = add

;-------------------------------------
; Stage portrait data
[Begin Action 9000]
9000,1, 0,0,-1

;-------------------------------------
; The lightning cycle, timed in game ticks (60 to the second): a long quiet, a
; strike with the bolt in it, a restrike, then a distant flash, then round again.
[Begin Action 9001]
2,0, 0,0, 150
2,1, 0,0, 2
2,2, 0,0, 5
2,0, 0,0, 4
2,1, 0,0, 2
2,2, 0,0, 6
2,0, 0,0, 145
2,1, 0,0, 3
2,2, 0,0, 9
2,0, 0,0, 1
