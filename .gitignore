# Ikemen GO runtime output
save/
*.log
Ikemen_GO.log
config.ini

# The engine that tools/test_local.py caches for playing this checkout
/.test/
# What "Update and Play.bat" keeps inside a game folder it updates
.update-cache/
/Ikemen_GO*
/*.exe
/*.dll
/*.so
/*.dylib
/*.app/
/*.command
/lib/

# Python tooling
__pycache__/
*.pyc

# OS junk
.DS_Store
Thumbs.db

# local export
*.bundle
*.tar.gz

# Release and historical build bundles: published as release assets, not source.
# Each is ~100-190 MB, over GitHub's 100 MB per-file limit.
artifacts/*.zip
artifacts/release/
artifacts/stage_art/

# Scratch copies of older revisions and build output, not source.
.r2/
.r3/
build/
dist/

# deploy key for pushing from this sandbox (never commit the private half)
.deploy_key
.deploy_key.pub

# prototype gang art from tools/gang_kfm.py --build, never shipped
chars/*_kfm/

# our shipped renderer defaults; the engine seed file is regenerated, ours is not
!config.ini

# Placeholder that keeps the folder in a checkout; the tracks themselves are
# added deliberately, so this one is never committed.
sound/.keep
