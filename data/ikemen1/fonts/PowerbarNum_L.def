[FNT v2]
; FNT v2 version number.  Don't change this.
fntversion = 2,00
; Name of this font.
name = "PowerbarNum_L"

[Def]
; Bitmap glyphs, baked for one size step of this face.
Type = bitmap
BankType = palette
; width is the space advance, height is the cell height
Size = 18,34
Spacing = 0,0
; the engine shifts glyphs by offset.y - Size.y + 1; this cancels the
; shift the taller cell would add, so the text keeps its top edge
Offset = 0,4
File = PowerbarNum_L.sff
